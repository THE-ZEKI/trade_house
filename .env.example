# Connexion a la base de donnees trade_house.
# En developpement : role applicatif NON proprietaire (obligatoire, sinon le RLS
# est contourne). Ne jamais utiliser le compte postgres dans l'application.
DATABASE_URL="postgresql://trade_house_app:CHANGEME@localhost:5432/trade_house"

# Taille du pool de connexions. Valeur par defaut : 10 (PostgreSQL local).
# NEON le plan gratuit plafonne a environ 10 connexions actives : y mettre 2,
# sinon le pool, le cron et les migrations saturent la base et des requetes
# echouent au pire moment.
DATABASE_POOL_MAX="10"

# URL publique de l'application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Duree de vie d'une session (RG : deconnexion / RG-60)
SESSION_TTL_HOURS="12"

# Fournisseur d'emails : log | resend | smtp
#   log     -> developpement, ecrit dans la sortie du serveur
#   resend  -> API HTTP (recommande sur Vercel : webhooks de bounce, pas de socket)
#   smtp    -> protocole standard, si Postfix est auto-heberge ou fourni par l'hebergeur
EMAIL_PROVIDER="log"
EMAIL_FROM="Trade House <no-reply@trade-house.local>"

# --- Resend (EMAIL_PROVIDER=resend) ---
RESEND_API_KEY=""
# pour suivre les bounces : recuperer l'URL de webhook et la declaree chez Resend

# --- SMTP (EMAIL_PROVIDER=smtp) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"        # true pour le port 465 (TLS direct), false pour 587 (STARTTLS)
SMTP_USER=""
SMTP_PASSWORD=""


# Secret du job cron (POST /api/cron/*) - obligatoire en production
CRON_SECRET=""

# Fournisseur video (phase 4, decision en attente) : daily | livekit
VIDEO_PROVIDER=""
DAILY_API_KEY=""
LIVEMIET_API_KEY=""

# Chiffrement des secrets (secret TOTP). 32 caracteres minimum.
# Generer avec : node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
APP_ENCRYPTION_KEY="a_remplacer_avec_une_cle_aleatoire_de_32"


# ============================================================================
# PRODUCTION — ce qu'il faut different de ce qui est au-dessus
# ============================================================================
#
# En production, /api/cron/* REFUSE tout appel sans CRON_SECRET, et la connexion
# doit se faire avec le role NON proprietaire trade_house_app. Verifier ensuite
# avec : curl https://<domaine>/api/health
# -> attendu : { "status": "ok", "rls": { "effective": true } }
# Un "degraded" signifie que le role connecte contourne le RLS : l'application
# fonctionne, mais sa securite est inopérante.
#
# Ordre de la premiere mise en ligne (Vercel) :
#   1. creer la base managée, jouer les migrations par le role PROPRIETAIRE
#   2. alter role trade_house_app login password '...'
#   3. declarer les variables ci-dessous dans l'interface Vercel
#   4. deployer, puis controler /api/health
#   5. creer l'administrateur : .\db\migrate.ps1 -Password '...' -AdminEmail 'admin@...'
#
# Rappel : EMAIL_PROVIDER="log" n'ecrit que dans la sortie du serveur — aucun
# courriel ne part. Passer a "resend" avant la mise en ligne.
